# === REQUIRED ===

# MongoDB connection string. For local dev:
#   docker compose up -d
#   then leave as-is
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/payload-starter
DATABASE_URL=mongodb://127.0.0.1/payload-starter

# Generated by `bun run setup` — do not commit your real value
PAYLOAD_SECRET=29d643aab3d23c1664cbf36992bf363bed7e43913e2aea03f55a5c6d32fd58c5

# No trailing slash. Used for CORS, OG metadata, sitemap, link generation.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Both generated by `bun run setup`
CRON_SECRET=e6150be24c0adb5822f784551a2abfba1ecb6f6a7969b3c7b9600d5f07fd32d8
PREVIEW_SECRET=444898fb9c40ca19404cc1bec1a6b479433c04345a50976738940cb5f3dd4ccf


# === STORAGE: local | r2 ===
#
# `local`  → files served from public/media (default, simplest)
# `r2`     → files served from Cloudflare R2
STORAGE_MODE=local


# === Cloudflare R2 (required only when STORAGE_MODE=r2) ===
#
# Setup:
#   1. Cloudflare dashboard → R2 → create bucket
#   2. Bucket → Settings → enable Public Access; copy the public URL
#   3. R2 → Manage API tokens → create token with Object Read & Write on the bucket
#   4. Add a CORS policy to the bucket allowing PUT, POST, GET from NEXT_PUBLIC_SERVER_URL
#
# R2_ENDPOINT format: https://<account-id>.r2.cloudflarestorage.com
# NEXT_PUBLIC_R2_PUBLIC_URL is optional; set it to serve images direct from R2's CDN.
# If unset, files are proxied through your Payload server (slower but simpler).

# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# NEXT_PUBLIC_R2_PUBLIC_URL=
